# Secrets exclusivos do servidor Supabase. Nunca usar prefixo VITE_ para estas chaves.
# Opção recomendada para o piloto: uma chave para busca e rotas de motocicleta.
MAPS_PROVIDER=geoapify
GEOAPIFY_API_KEY=
# Alternativa: MAPS_PROVIDER=compatible com serviços próprios/contratados.
GEOCODER_BASE_URL=
ROUTER_BASE_URL=
MAPS_PROVIDER_TOKEN=
