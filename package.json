{
  "name": "motoja",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node scripts/test-database.mjs && node scripts/test-database.mjs --legacy",
    "test:e2e": "playwright test",
    "native:sync": "npm run build && cap sync",
    "configure:pilot": "node scripts/configure-pilot.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.5.2",
    "@supabase/supabase-js": "2.116.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
